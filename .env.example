# Copy to .env and fill in the three blank values. .env is git-ignored; never commit it.
# Docker Compose refuses to start while they are blank, so no sample secret can end up in use by accident.
#
# Generate strong values with:  openssl rand -base64 48

POSTGRES_DB=stockguard
POSTGRES_USER=stockguard
POSTGRES_PASSWORD=

# Signs access tokens. Must be at least 32 characters and the same on every instance.
STOCKGUARD_JWT_SECRET=

# First administrator, created on startup if it does not exist yet.
STOCKGUARD_ADMIN_USERNAME=admin
# 10 to 72 characters.
STOCKGUARD_ADMIN_PASSWORD=

# Lets administrators run the concurrency simulation. It creates demo data, so turn it off outside demos.
STOCKGUARD_SIMULATION_ENABLED=true

# Host ports, all bound to localhost.
STOCKGUARD_APP1_HOST_PORT=8095
STOCKGUARD_APP2_HOST_PORT=8096
STOCKGUARD_DB_HOST_PORT=5442
